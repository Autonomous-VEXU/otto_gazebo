<?xml version='1.0'?>
<robot name="Otto_lite" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <static>false</static>

    <!-- properties-->
    <xacro:property name="model_path" value="package://otto_description/models"/>
    <xacro:property name="package_path" value="package://otto_gazebo/config"/>

    <!--Wheel properties-->
    <xacro:property name="wheel_offs" value="0.14"/>
    <xacro:property name="wheel_rad" value="0.0349253"/>
    <xacro:property name="wheel_width" value="0.02159"/>
    
    <!--world link-->
    <link name='base_footprint'/>

    <!--base_link link-->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>

            <geometry>  
                <box size='0.20 0.20 0.02'/>
            </geometry>

            <material name="pink">
                <color rgba="0.93 0.28 0.60 1.0"/> 
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                 <box size='0.20 0.20 0.02'/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.54"/>
           <inertia
                ixx="0.05487"
                ixy="0.0"
                ixz="0.0"
                iyy="0.05487"
                iyz="0.0"
                izz="0.10974"/>
            </inertial>
    </link>

    <link name="intake_link">
        <visual>
            <origin xyz='0 0 0' rpy='0 0 0'/>
            <geometry>
                <box size='0.189 0.146 0.20'/>
            </geometry>
            <material name="light-blue">
                <color rgba="0.68 0.85 0.9 1"/> 
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size='0.189 0.146 0.10'/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.070"/>
            <inertia
            ixx="0.001"
            ixy="0.0"
            ixz="0.0"
            iyy="0.001"
            iyz="0.0"
            izz="0.001"/>
        </inertial>
    </link>


    <!--imu link-->
    <link name="imu_link"/>

    <!-- IMU -->
    <gazebo reference='imu_link'>
         <sensor name="tb3_imu" type="imu"> <!--taken from turtlebot3_simulations-->
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- wheels -->
    <xacro:macro name="wheel_link" params="name">
        <link name="${name}">
            <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius='${wheel_rad}' length='${wheel_width}' />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>

            <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius='${wheel_rad}' length='${wheel_width}' />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.070"/>
                <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0.0"
                izz="0.001"/>
            </inertial>
        </link>

        <gazebo reference="${name}">
            <mu1 value="0.2"/>
            <mu2 value="1.5"/>
            <kp value="10000000.0" />
            <kd value="10000.0" />
            <fdir1 value="0 0 1"/>
            <maxContacts value= "1"/>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_link name="wheel_a"/>
    <xacro:wheel_link name="wheel_b"/>
    <xacro:wheel_link name="wheel_c"/>
    <xacro:wheel_link name="wheel_d"/>


    <!-- LiDAR x2 -->
    <xacro:macro name='TiMXXS_lidar' params='sensor_number xyz yaw'>
        <!-- lidar link -->
        <link name="laser_frame_${sensor_number}">
            <visual>
                <origin xyz="0 0 0.0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" />
                <mass value="0.114" />
                <inertia 
                ixx="0.001" 
                ixy="0.0" 
                ixz="0.0" 
                iyy="0.001"
                iyz="0.0" 
                izz="0.001"/>
            </inertial>
        </link>

        <!-- lidar joint -->
        <joint name="laser_joint_${sensor_number}" type="fixed">
            <parent link="base_link"/>
            <child link="laser_frame_${sensor_number}"/>
            <origin xyz="${xyz}" rpy="0 0 ${yaw}"/> 
        </joint>

        <!-- actual sensor-->
        <gazebo reference="laser_frame_${sensor_number}">
            <sensor name="lidar_${sensor_number}" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <topic>scan_${sensor_number}</topic>
                <gz_frame_id>laser_frame_${sensor_number}</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>720</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.76794</min_angle> <!-- -0.76794 = -44 deg, 0.78539 = -45-->
                            <max_angle>3.90953</max_angle> <!-- 3.90953 = 224 deg, 3.92699 = 225-->
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:TiMXXS_lidar sensor_number='1' xyz="-0.13 0.12 0.14" yaw='${1* pi/4}'/>
    <xacro:TiMXXS_lidar sensor_number='2' xyz="-0.13 -0.12 0.14" yaw='${3* pi/4}'/> 
    
    <!-- Joints -->
    <joint name="footprint_2_link" type='fixed'>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <parent link='base_footprint'/>
        <child link='base_link'/>
    </joint>

    <joint name="base_2_intake" type='fixed'>
        <origin xyz="0.0945 0 0.16" rpy="0 0 0"/>
        <parent link='base_link'/>
        <child link='intake_link'/>
    </joint>

    <joint name="chassis_to_wheel_a" type="continuous">
        <origin xyz="-${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 ${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_a"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_b" type="continuous"> 
        <origin xyz="${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${-3* (pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_b"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_c" type="continuous">
        <origin xyz="${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 -${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_c"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="chassis_to_wheel_d" type="continuous">
        <origin xyz="-${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${3 *(pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_d"/>
        <axis xyz="0 1 0"/> 
    </joint>

    <!--Sensor Joints-->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>

    <!-- ROS 2 Control-->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="chassis_to_wheel_a">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_b">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_c">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="chassis_to_wheel_d">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- Gazebo Sim Plugins -->
    <gazebo>
          <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find otto_gazebo)/config/omni_wheel_params.yaml</parameters>
          </plugin>
    </gazebo>

</robot>