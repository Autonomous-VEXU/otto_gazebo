<?xml version='1.0'?>
<robot name="x_drive" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

	<static>false</static>

	<!-- properties-->
	<xacro:property name="model_path" value="package://robot_description/models"/>
	<xacro:property name="package_path" value="package://robot_gazebo/config"/>
	<xacro:property name="wheel_offs" value="0.14"/>
	<xacro:property name="wheel_rad" value="0.01375"/>
	<xacro:property name="wheel_width" value="0.02159"/>
	
	<!--world link-->
	<link name='base_footprint'/>

	<!--chassis link-->
	<link name="base_link">
		<visual>
			<geometry>
				<mesh filename='${model_path}/chassis.dae'/>
			</geometry>
			<material name="pink">
                <color rgba="0.93 0.28 0.60 1.0"/> 
			</material>
		</visual>

		<collision>
			<geometry>
				<mesh filename='${model_path}/chassis.dae'/>
			</geometry>
		</collision>

		<inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.54"/>
           <inertia
      			ixx="0.05487"
				ixy="0.0"
				ixz="0.0"
				iyy="0.05487"
				iyz="0.0"
				izz="0.10974"/>
    		</inertial>
	</link>

	<!-- wheels -->
	<xacro:macro name="wheel_link" params="name">
		<link name="${name}">

			<visual>
			<origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
				<geometry>
					<cylinder radius='${wheel_rad*2}' length='${wheel_width}' />
				</geometry>
				<material name="dark_grey">
					<color rgba="0.2 0.2 0.2 1.0"/>
				</material>
			</visual>

			<collision>
			<origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
				<geometry>
					<cylinder radius='${wheel_rad*2}' length='${wheel_width}' />
				</geometry>
					<surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
			</collision>

			<inertial>
            	<origin xyz="0 0 0" rpy="0 0 0"/>
            	<mass value="0.070"/>
				<inertia
      			ixx="0.001"
				ixy="0.0"
				ixz="0.0"
				iyy="0.001"
				iyz="0.0"
				izz="0.001"/>
        	</inertial>
		</link>
	</xacro:macro>

	<xacro:wheel_link name="wheel_a"/>
	<xacro:wheel_link name="wheel_b"/>
	<xacro:wheel_link name="wheel_c"/>
	<xacro:wheel_link name="wheel_d"/>


	<!-- joints -->
	<joint name="world_2_chassis" type='fixed'>
		<origin xyz="0 0 0.025" rpy="0 0 0"/>
		<parent link='base_footprint'/>
		<child link='base_link'/>
	</joint>

	<joint name="chassis_to_wheel_a" type="continuous">
        <origin xyz="-${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 ${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_a"/>
		<axis xyz="0 1 0"/> 
    </joint>

	<joint name="chassis_to_wheel_b" type="continuous">
        <origin xyz="${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${-3* (pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_b"/>
		<axis xyz="0 1 0"/> 
    </joint>

	<joint name="chassis_to_wheel_c" type="continuous">
        <origin xyz="${wheel_offs} ${wheel_offs} ${wheel_rad}" rpy="0 0 -${pi/4}"/>
        <parent link="base_link"/>
        <child link="wheel_c"/>
		<axis xyz="0 1 0"/> 
    </joint>

	<joint name="chassis_to_wheel_d" type="continuous">
        <origin xyz="-${wheel_offs} -${wheel_offs} ${wheel_rad}" rpy="0 0 ${3 *(pi/4)}"/>
        <parent link="base_link"/>
        <child link="wheel_d"/>
		<axis xyz="0 1 0"/> 
    </joint>

	<!-- ROS 2 Control-->
	<ros2_control name="GazeboSystem" type="system">
	    <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
		<joint name="chassis_to_wheel_a">
   			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
 		</joint>
		<joint name="chassis_to_wheel_b">
   			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
 		</joint>
		<joint name="chassis_to_wheel_c">
   			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
 		</joint>
		<joint name="chassis_to_wheel_d">
   			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
 		</joint>
	</ros2_control>
	<!-- gazebo stuff -->
	<gazebo>
  		<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
			<parameters>$(find robot_gazebo)/config/omni_wheel_params.yaml</parameters>
  		</plugin>
	</gazebo>

</robot>